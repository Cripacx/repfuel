# repfuel — Konfiguration (Kopie als .env ablegen: cp .env.example .env)

# PostgreSQL-Verbindung (im Compose-Netz heißt der Host "db")
DATABASE_URL=postgres://repfuel:repfuel@db:5432/repfuel

# Passwort des Postgres-Containers (muss zur DATABASE_URL passen)
POSTGRES_PASSWORD=repfuel

# Redis-Verbindung (Sessions, Auth-Flows; im Compose-Netz heißt der Host "redis")
REDIS_URL=redis://redis:6379

# Öffentliche Origin der App — ZWINGEND korrekt für Passkeys (WebAuthn).
# Muss exakt der URL entsprechen, unter der Nutzer die App öffnen,
# z.B. https://fit.example.com (HTTPS ist Voraussetzung für Passkeys außer auf localhost).
ORIGIN=http://localhost:8080

# Port, auf dem die App lauscht
PORT=8080

# Registrierungsmodus: open (jeder kann sich registrieren) | invite (nur mit Invite-Link).
# Der erste registrierte Nutzer wird immer Admin; der Admin kann den Modus im UI überschreiben.
REGISTRATION_MODE=open

# Session-Lebensdauer in Tagen
SESSION_TTL_DAYS=30

# Log-Level des Servers: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Verzeichnis mit den Übungsmedien (Unterordner img/ und gif/), ausgeliefert
# unter /media. Wird von docker compose automatisch gesetzt und aus dem Volume
# `media-data` befüllt (Service `exercise-media`, einmaliger Download ~140 MB).
# Leer lassen = keine Übungsbilder/-animationen. Die Medien gehören Gym visual
# (https://gymvisual.com/) und liegen bewusst nicht im Repo/Image — siehe
# apps/server/src/modules/workout/seed/README.md.
MEDIA_DIR=

# ---------- KI (strikt optional — none = Chat & KI-Features aus) ----------

# Provider: none | anthropic | openai | openrouter | ollama | claude-local | codex-local
# (claude-local/codex-local = lokale CLI im Sidecar; "cli" bleibt Alias für claude-local)
AI_PROVIDER=none

# API-Key des Providers (für anthropic/openai/openrouter; bei ollama leer lassen)
AI_API_KEY=

# Coach-Modell — Provider-spezifische Modell-ID, z.B.:
#   anthropic:    claude-opus-5
#   openai:       gpt-5.2
#   openrouter:   anthropic/claude-opus-5
#   ollama:       qwen3 (Modell muss Tool-Calling können — wird beim Status geprüft)
#   claude-local: opus | sonnet | claude-opus-5 (leer = Default der CLI)
#   codex-local:  gpt-5.2-codex (leer = Default der CLI)
AI_MODEL=

# Optionales günstiges Modell für Hilfsaufgaben (leer = AI_MODEL)
AI_MODEL_LIGHT=

# Basis-URL für ollama (http://ollama:11434/v1 im Compose) oder OpenAI-kompatible Endpunkte
AI_BASE_URL=

# --- CLI-Adapter (AI_PROVIDER=claude-local|codex-local, Compose-Profil "cli-adapter") ---

# Empfohlener Headless-Auth-Weg: auf einem Rechner mit Claude-Login
# `claude setup-token` ausführen und den Token hier eintragen.
# Alternativen: siehe docs/AI_CLI.md
CLAUDE_CODE_OAUTH_TOKEN=

# Codex CLI (AI_PROVIDER=codex-local): API-Key-Auth; alternativ ~/.codex
# als Volume mounten (ChatGPT-Abo via `codex login`), siehe docs/AI_CLI.md.
CODEX_API_KEY=

# HTTP-Endpunkt des Sidecars (Compose-Default passt)
AI_SIDECAR_URL=http://ai-cli:8090

# URL, unter der der Sidecar den MCP-Wrapper des Backends erreicht (Compose-Default passt)
AI_MCP_URL=http://app:8080/internal/mcp
